<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Ledger.Data</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ledger.Core\Ledger.Core.csproj" />
    <ProjectReference Include="..\Ledger.Shared\Ledger.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      EF Core SQLite, paired with the SQLCipher-enabled native bundle.
      We use 'Sqlite.Core' (no native binaries) and add 'bundle_e_sqlcipher' explicitly
      so the same SQLite provider transparently encrypts the database file at rest.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.10" />
  </ItemGroup>

</Project>
