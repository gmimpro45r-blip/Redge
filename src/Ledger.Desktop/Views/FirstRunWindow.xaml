<Window x:Class="Ledger.Desktop.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Welcome to Ledger — Create your Administrator account"
        Width="560" Height="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{md:MaterialDesignFont}"
        TextElement.FontSize="14">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Welcome"
                   Style="{StaticResource MaterialDesignHeadline4TextBlock}" />
        <TextBlock Grid.Row="1"
                   Text="Create the first Administrator account. This user can manage other users, post entries, and close periods."
                   Margin="0,4,0,24"
                   TextWrapping="Wrap"
                   Style="{StaticResource MaterialDesignBody1TextBlock}"
                   Opacity="0.7" />

        <TextBox Grid.Row="2"
                 md:HintAssist.Hint="Username"
                 md:HintAssist.IsFloating="True"
                 Style="{StaticResource MaterialDesignFilledTextBox}"
                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="64"
                 Margin="0,0,0,12" />

        <TextBox Grid.Row="3"
                 md:HintAssist.Hint="Display name"
                 md:HintAssist.IsFloating="True"
                 Style="{StaticResource MaterialDesignFilledTextBox}"
                 Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="128"
                 Margin="0,0,0,12" />

        <PasswordBox Grid.Row="4"
                     md:HintAssist.Hint="Password (min 8 chars)"
                     md:HintAssist.IsFloating="True"
                     Style="{StaticResource MaterialDesignFilledPasswordBox}"
                     md:TextFieldAssist.HasClearButton="True"
                     x:Name="PasswordBox"
                     PasswordChanged="PasswordBox_PasswordChanged"
                     MaxLength="256"
                     Margin="0,0,0,12" />

        <PasswordBox Grid.Row="5"
                     md:HintAssist.Hint="Confirm password"
                     md:HintAssist.IsFloating="True"
                     Style="{StaticResource MaterialDesignFilledPasswordBox}"
                     md:TextFieldAssist.HasClearButton="True"
                     x:Name="PasswordConfirmBox"
                     PasswordChanged="PasswordConfirmBox_PasswordChanged"
                     MaxLength="256"
                     Margin="0,0,0,16" />

        <TextBlock Grid.Row="6"
                   Text="{Binding ErrorMessage}"
                   Foreground="#D32F2F"
                   TextWrapping="Wrap"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

        <ProgressBar Grid.Row="7"
                     VerticalAlignment="Top"
                     Margin="0,16,0,0"
                     IsIndeterminate="True"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

        <StackPanel Grid.Row="8"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="CREATE ADMIN"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    IsDefault="True"
                    Command="{Binding CreateCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
        </StackPanel>
    </Grid>
</Window>
