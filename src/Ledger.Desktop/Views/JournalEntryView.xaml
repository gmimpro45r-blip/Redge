<UserControl x:Class="Ledger.Desktop.Views.JournalEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource MaterialDesignPaper}"
             FontFamily="{md:MaterialDesignFont}"
             FlowDirection="{Binding FlowDirection}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- Header card -->
            <RowDefinition Height="*"   />    <!-- Lines grid  -->
            <RowDefinition Height="Auto" />   <!-- Totals      -->
            <RowDefinition Height="Auto" />   <!-- Action bar  -->
        </Grid.RowDefinitions>

        <!-- Header: entry no, date, currency, FX rate, description -->
        <md:Card Grid.Row="0" Padding="16" Margin="0,0,0,12" UniformCornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBox Grid.Column="0" Grid.Row="0"
                         md:HintAssist.Hint="Entry No"  md:HintAssist.IsFloating="True"
                         Text="{Binding EntryNo, Mode=OneWay}" IsReadOnly="True" />
                <DatePicker Grid.Column="1" Grid.Row="0"
                            md:HintAssist.Hint="Entry Date" md:HintAssist.IsFloating="True"
                            SelectedDate="{Binding EntryDate}" Margin="8,0,0,0" />
                <ComboBox Grid.Column="2" Grid.Row="0"
                          md:HintAssist.Hint="Currency" md:HintAssist.IsFloating="True"
                          ItemsSource="{Binding Currencies}"
                          SelectedValue="{Binding Currency}"
                          Margin="8,0,0,0" />
                <TextBox Grid.Column="3" Grid.Row="0"
                         md:HintAssist.Hint="FX Rate" md:HintAssist.IsFloating="True"
                         Text="{Binding ExchangeRate}"
                         Margin="8,0,0,0" />

                <TextBox Grid.ColumnSpan="4" Grid.Row="1"
                         md:HintAssist.Hint="Description"
                         md:HintAssist.IsFloating="True"
                         Margin="0,16,0,0"
                         Text="{Binding Description}" />
            </Grid>
        </md:Card>

        <!-- Lines DataGrid -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Lines}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="True"
                  CanUserDeleteRows="True"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding LineNo, Mode=OneWay}" IsReadOnly="True" Width="40" />
                <DataGridComboBoxColumn Header="Account"
                                        SelectedValueBinding="{Binding AccountId}"
                                        SelectedValuePath="Id"
                                        DisplayMemberPath="Code"
                                        Width="*" />
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*" />
                <DataGridTextColumn Header="Debit"  Binding="{Binding Debit,  StringFormat=N4}" Width="120" />
                <DataGridTextColumn Header="Credit" Binding="{Binding Credit, StringFormat=N4}" Width="120" />
                <DataGridComboBoxColumn Header="Cost Center"
                                        SelectedValueBinding="{Binding CostCenterId}"
                                        SelectedValuePath="Id"
                                        DisplayMemberPath="Code"
                                        Width="160" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Totals row -->
        <Border Grid.Row="2" Padding="12,8" Margin="0,8,0,0"
                Background="{DynamicResource MaterialDesignDivider}"
                CornerRadius="4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Total Debit:"  Margin="0,0,8,0"  Style="{StaticResource MaterialDesignBody2TextBlock}" />
                <TextBlock Text="{Binding TotalDebit,  StringFormat=N4}" Margin="0,0,24,0" FontFamily="Consolas" />
                <TextBlock Text="Total Credit:" Margin="0,0,8,0" Style="{StaticResource MaterialDesignBody2TextBlock}" />
                <TextBlock Text="{Binding TotalCredit, StringFormat=N4}" Margin="0,0,24,0" FontFamily="Consolas" />
                <TextBlock Text="Status:"      Margin="0,0,8,0" Style="{StaticResource MaterialDesignBody2TextBlock}" />
                <TextBlock Text="{Binding BalanceStatus}" FontWeight="Bold"
                           Foreground="{Binding BalanceStatusBrush}" />
            </StackPanel>
        </Border>

        <!-- Action bar -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="SAVE DRAFT"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Margin="0,0,8,0"
                    Command="{Binding SaveDraftCommand}" />
            <Button Content="POST"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    IsEnabled="{Binding CanPost}"
                    Command="{Binding PostCommand}" />
            <Button Content="REVERSE"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Margin="8,0,0,0"
                    Visibility="{Binding CanReverse, Converter={StaticResource BoolToVis}}"
                    Command="{Binding ReverseCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
