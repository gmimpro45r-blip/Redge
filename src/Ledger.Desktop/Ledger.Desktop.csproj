<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Ledger.Desktop</RootNamespace>
    <AssemblyName>Ledger.Desktop</AssemblyName>
    <UseWPF>true</UseWPF>
    <ApplicationIcon Condition="Exists('..\..\deploy\icons\app.ico')">..\..\deploy\icons\app.ico</ApplicationIcon>
    <!-- WPF builds only on Windows. CI guards this project on the windows-latest runner. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ledger.Core\Ledger.Core.csproj" />
    <ProjectReference Include="..\Ledger.Services\Ledger.Services.csproj" />
    <ProjectReference Include="..\Ledger.Shared\Ledger.Shared.csproj" />
  </ItemGroup>

  <!-- NuGet packages (MaterialDesign, MVVM Toolkit, etc.) are added in milestone 5. -->

</Project>
