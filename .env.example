# Copy to .env and fill in real values.  NEVER commit .env to source control.

# --- Supabase ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=

# Used by ./scripts/setup-supabase.sh (NOT consumed by the app)
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# --- n8n ---
N8N_DOMAIN=https://YOUR-INSTANCE.app.n8n.cloud
N8N_API_KEY=
N8N_WEBHOOK_SECRET=replace-with-a-long-random-string
