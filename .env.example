# Optional environment overrides for Ledger Desktop.
# In a 100% offline build none of these are required; sane defaults are baked in.
# They exist mainly for OEM / white-label distributions.

# Where the encrypted SQLite database lives. Default: %LOCALAPPDATA%\Redge\ledger.db
LEDGER_DB_PATH=

# Override the application name shown in the title bar / installer (white-label).
LEDGER_APP_NAME=

# Default theme on first run: "Light" or "Dark".
LEDGER_DEFAULT_THEME=Light

# Default flow direction on first run: "LeftToRight" or "RightToLeft".
LEDGER_DEFAULT_FLOW=LeftToRight
